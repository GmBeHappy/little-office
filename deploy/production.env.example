OFFICE_IMAGE=ghcr.io/gmbehappy/little-office:latest
CADDY_IMAGE=ghcr.io/gmbehappy/little-office-caddy:latest
OFFICE_PULL_POLICY=always
CADDY_PULL_POLICY=always
APP_URL=https://office.example.com
OFFICE_DOMAIN=office.example.com
# Optional tenant hosts: <workspace-slug>.littleoffice.app. Use app.littleoffice.app
# for OFFICE_DOMAIN / APP_URL, and point wildcard A/AAAA records at this VM.
# Caddy obtains individual certificates only for workspace slugs present in the DB.
WORKSPACE_BASE_DOMAIN=
# Optional paired redirect settings for a previous single-office hostname.
LEGACY_OFFICE_DOMAIN=
LEGACY_WORKSPACE_SLUG=
RTC_DOMAIN=rtc.example.com
TURN_DOMAIN=turn.example.com
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
# Use a random hex password here and in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex
DATABASE_URL=postgres://office:replace-with-random-hex@127.0.0.1:5432/office
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
# Match the existing firewall UDP range when upgrading a deployment.
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=60000
LIVEKIT_API_KEY=replace-with-random-key
LIVEKIT_API_SECRET=replace-with-random-secret-at-least-32-characters
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OFFICE_OPERATOR_IDS=
OFFICE_MEDIA_NAMESPACE=
