APP_URL=http://localhost:3000
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
DATABASE_URL=postgres://office:office@127.0.0.1:5432/office
# Generate with: bun -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Leave blank until your SSO provider is ready.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional private external S3-compatible file storage (Garage example).
# Access keys are server-only. Leave blank to disable uploads; no local fallback.
OFFICE_S3_ENDPOINT=
OFFICE_S3_REGION=garage
OFFICE_S3_BUCKET=
OFFICE_S3_ACCESS_KEY_ID=
OFFICE_S3_SECRET_ACCESS_KEY=
