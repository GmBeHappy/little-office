    "Permission dismissed": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดหน้าต่างขออนุญาตแล้ว"
          }
        }
      }
    },
    "Interactive pixel office. Move with WASD or arrow keys, or touch and drag to walk. Release to stop. Press Space to jump. Tap a person or meeting room to interact, or use the Rooms list for keyboard-accessible navigation.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออฟฟิศพิกเซลแบบโต้ตอบ ใช้ WASD ปุ่มลูกศร หรือแตะแล้วลากเพื่อเดิน ปล่อยเพื่อหยุด กด Space เพื่อกระโดด แตะคนหรือห้องประชุมเพื่อโต้ตอบ หรือใช้รายชื่อห้องด้วยแป้นพิมพ์"
          }
        }
      }
    },
    "This meeting room is locked. Ask someone inside to summon you.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องประชุมนี้ล็อกอยู่ ขอให้คนข้างในเชิญคุณเข้าไป"
          }
        }
      }
    },
    "Little Office — a place to work together": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Office — พื้นที่ทำงานร่วมกัน"
          }
        }
      }
    },
    "A cozy pixel office for your team. Walk over, say hello, and work together.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออฟฟิศพิกเซลแสนอบอุ่นสำหรับทีม เดินไปทักทาย แล้วทำงานด้วยกัน"
          }
        }
      }
    },
    "Disconnected": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
