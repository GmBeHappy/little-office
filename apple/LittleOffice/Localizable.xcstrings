    },
    "Add your OIDC issuer and client credentials to the server first.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่า OIDC issuer และข้อมูลไคลเอนต์บนเซิร์ฟเวอร์ก่อน"
