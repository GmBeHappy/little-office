def required_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Set #{name} before running this lane") if value.empty?
  value
end

def signed_release_config!
  %w[ANDROID_KEYSTORE_FILE ANDROID_KEYSTORE_PASSWORD ANDROID_KEY_ALIAS ANDROID_KEY_PASSWORD].each do |name|
    required_env(name)
  end
  UI.user_error!("Signing keystore does not exist") unless File.file?(ENV.fetch("ANDROID_KEYSTORE_FILE"))
  version = required_env("ANDROID_VERSION_CODE")
  UI.user_error!("ANDROID_VERSION_CODE must be 1..2100000000") unless version.match?(/\A[1-9]\d*\z/) && version.to_i <= 2_100_000_000
end

default_platform(:android)

platform :android do
  desc "Test, lint and build local/PR artifacts without release credentials"
  lane :verify do
    gradle(tasks: [":app:testDebugUnitTest", ":app:lintDebug", ":app:assembleDebug", ":app:bundleRelease"])
  end

  desc "Build a signed release APK; signing values stay in environment variables"
  lane :release do
    signed_release_config!
    gradle(task: ":app:assembleRelease")
  end

  desc "Upload the signed release APK using Google Application Default Credentials"
  lane :distribute do
    app = required_env("FIREBASE_ANDROID_APP_ID")
    UI.user_error!("Expected an Android Firebase App ID") unless app.match?(/\A1:\d+:android:[a-zA-Z0-9]+\z/)
    credentials = required_env("GOOGLE_APPLICATION_CREDENTIALS")
    UI.user_error!("Google ADC file does not exist") unless File.file?(credentials)
    apk = File.expand_path("../app/build/outputs/apk/release/app-release.apk", __dir__)
    UI.user_error!("Run the release lane first; signed APK is missing") unless File.file?(apk)
    firebase_app_distribution(
      app: app,
      service_credentials_file: credentials,
      android_artifact_type: "APK",
      android_artifact_path: apk,
      groups: ENV.fetch("FIREBASE_GROUPS", ""),
      release_notes: ENV.fetch("RELEASE_NOTES", "Little Office Android beta"),
      debug: false
    )
  end
end
